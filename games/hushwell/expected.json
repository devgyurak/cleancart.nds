 "about": "Expected result-block values of the Hushwell feature demos, judged by tools/judge.py. Each demo writes a result block at 0x0237F000 at frame 120 (magic CVER, FNV-1a of the demo name, frame, values[13]); see docs/QA.md. Items test what the values say: documented register read-backs, hardware counters, self-checks. Pure ROM constants and demos that are checked by eye only (screens, sound) are listed in docs/QA.md and are not judged yet.",
 "block": {
  "address": "0x0237F000",
  "magic": 1380275779
 },
 "sources": {
  "GBATEK": "documented hardware behaviour; gating",
  "report:<ref>": "a hardware report by a third party; gating",
  "hw:<model>": "measured by us on real hardware; gating",
  "rom": "decided by the ROM's own deterministic logic, independent of the emulator; gating",
  "unconfirmed": "no hardware value yet; informational only, never fails the run (with --profile it is reported when it changes, not counted)"
 },
 "checks": {
  "eq": "values[i] == expect",
  "range": "min <= values[i] <= max",
  "mask": "(values[i] & mask) == expect",
  "same": "all values equal (two or more indexes)",
  "na_when": "[i, v]: the item is n/a when values[i] == v (the emulator has no such counter; DeSmuME reads 0 for the polygon counters)",
  "optional": "demos listed in \"optional\" need no RESULT line (qa: the block of the main ROM's auto QA run; grade it with --demo qa)",
  "nonzero": "(values[i] & mask) != 0",
  "ne": "values[i] != values[j] (two indexes)",
  "not_value": "item field: the item fails when any of its values equals it (0xFFFF = capture did not finish)"
 },
