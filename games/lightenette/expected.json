  "schema": 3,
  "target_level": 2,
  "area": "display edge cases",
  "about": "Expected result-block values for the Lightenette rehearsal and judge ROMs, judged by tools/judge.py. Block layout: arm9/source/game/rehearsal.h and arm9/source/judge/judge.h. An item may name the captures it depends on (\"done\": the value index and bit mask that must be set) and whether it reads pixels (\"pixels\": a value above 0x7FFF is the ROM's 'not captured' marker). \"frame\" is the minimum number of frames to run, per boot. \"known\" lists, per emulator version and renderer, the gating items expected to fail there; judge.py --profile passes only when the failing set matches exactly.",
  "block": {
    "address": "0x0237F000",
    "magic": 1380275779,
    "act_ids": {
      "ACT1": 827605825,
      "ACT2": 844383041,
      "ACT3": 861160257,
      "ACT4": 877937473,
      "ACT5": 894714689
    },
    "act_ids_note": "per-act blocks left while an act's loop runs; seeing one means the rehearsal did not finish"
  },
  "sources": {
    "GBATEK": "documented hardware behaviour; gating",
    "report:<ref>": "a hardware report by a third party (e.g. report:melonDS#2008); gating",
    "hw:<model>": "measured by us on real hardware; gating",
    "rom": "decided by the ROM's own deterministic logic, independent of the emulator; gating",
    "unconfirmed": "no hardware value yet; informational only, never fails the run"
  },
  "boots": {
    "rehearsal": {
      "rom": "lightenette-rehearsal.nds",
      "item_id": 1279608914,
      "item_id_text": "RHEL",
      "frames": 1800,
      "note": "act 1 from the embedded touch script, acts 2 to 5 from embedded key scripts, then the judge; no save chip, no NitroFS. Ends at about frame 864 (melonDS) / 954 (DeSmuME); the worst case, every act running to its own limit, is about 1640 frames"
    },
    "acc-stage": {
      "rom": "lightenette-acc-stage.nds",
      "item_id": 1245988684,
      "item_id_text": "LGDJ",
      "frames": 180,
      "note": "the judge scene alone"
    },
    "qa": {
      "rom": "lightenette.nds",
      "item_id": 1314013521,
      "item_id_text": "QARN",
      "frames": 4000,
      "note": "the release ROM's hidden auto QA mode (title: hold L+R+X+Y for 120 frames): the normal flow title, acts 1-5 with the rehearsal's scripts, credits, then the accuracy judge once; the block uses the rehearsal's layout (values[0..44]) and adds the QA words at values[48..54] (verdict 1 PASS / 2 FAIL, log lines, SD flags, last state hash, checkpoints, lag, save flags). Ends at about frame 2090 after the combo (melonDS)"
    },
    "l2-sys-irq": {
      "rom": "lightenette-l2-sys-irq.nds",
      "item_id": 1414528060,
      "item_id_text": "l2-sys-irq",
      "frames": 120,
      "note": "level 2 demo (Corvane demo sys-irq): IRQ counts over 120 frames (VBlank, HBlank, VCOUNT 96, 10 Hz timer, key IRQ). Result block as Corvane's demos (values from words[3:], 13 words are enough); no save chip, no NitroFS"
    },
    "l2-sys-dma-vblank": {
      "rom": "lightenette-l2-sys-dma-vblank.nds",
      "item_id": 619872727,
      "item_id_text": "l2-sys-dma-vblank",
      "frames": 120,
      "note": "level 2 demo (Corvane demo sys-dma-vblank): a palette DMA started at VBlank in each of 120 frames. Result block as Corvane's demos (values from words[3:], 13 words are enough); no save chip, no NitroFS"
    },
    "l2-sys-math": {
      "rom": "lightenette-l2-sys-math.nds",
      "item_id": 404087652,
      "item_id_text": "l2-sys-math",
      "frames": 120,
      "note": "level 2 demo (Corvane demo sys-math): hardware divide, 64-bit square root, vector length, atan2. Result block as Corvane's demos (values from words[3:], 13 words are enough); no save chip, no NitroFS"
    },
    "l2-3d-limits": {
      "rom": "lightenette-l2-3d-limits.nds",
      "item_id": 1911496040,
      "item_id_text": "l2-3d-limits",
      "frames": 120,
      "note": "level 2 demo (Corvane demo 3d-limits): 600-2980 triangles per frame against the 2048-polygon RAM; values[0] overflow frames, values[1] polygons in RAM. Result block as Corvane's demos (values from words[3:], 13 words are enough); no save chip, no NitroFS"
    },
    "l2-acc-dual": {
      "rom": "lightenette-l2-acc-dual.nds",
      "item_id": 2329324468,
      "item_id_text": "l2-acc-dual",
      "frames": 120,
      "note": "level 2 demo (Corvane demo acc-dual): dual-screen 3D and two-pass rendering through the display capture; values[3] is a flag word (bit 1 one pass overflows, 2 two passes fit, 3 both halves have pixels). Result block as Corvane's demos (values from words[3:], 13 words are enough); no save chip, no NitroFS"
    },
    "l2-2d-affine": {
      "rom": "lightenette-l2-2d-affine.nds",
      "item_id": 2673561160,
      "item_id_text": "l2-2d-affine",
