 "schema": 3,
 "target_level": 4,
 "area": "research probes",
 "about": "Probe results of the L4 research collection (probes/): behaviours nobody has confirmed on hardware (docs/LEVELS.md). Each probe ROM is Corvane demo code run under an l4- name; it writes a result block at 0x0237F000 at frame 120 (magic CVER, FNV-1a of the demo name, frame, values[13]). The items are informational: they never fail a run. `known.<profile>.observed` records what each emulator gave per item; tools/judge.py --profile exits 1 when an emulator no longer matches its record (a change is news). The `expect`/`min`/`max` fields are the reference value the item was written from (what melonDS software gave), not a hardware value.",
 "block": {
  "address": "0x0237F000",
  "magic": 1380275779
 },
 "sources": {
  "unconfirmed": "no hardware value yet; informational only, never fails the run (with --profile the recorded observation is compared)"
 },
 "checks": {
  "eq": "values[i] == expect",
  "range": "min <= values[i] <= max",
  "mask": "(values[i] & mask) == expect",
  "same": "all values equal (two or more indexes)",
  "na_when": "[i, v]: the item is n/a when values[i] == v (the emulator has no such counter; DeSmuME reads 0 for the polygon counters)",
  "nonzero": "(values[i] & mask) != 0",
  "ne": "values[i] != values[j] (two indexes)",
  "not_value": "item field: the item fails when any of its values equals it (0xFFFF = capture did not finish)"
 },
